# ==============================================================================
# ConfMan - Conference Management System Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real production credentials or secrets to version control.
# In Vercel, set these environment variables in Project Settings > Environment Variables.

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Secret key used for session cookie signing and CSRF tokens.
# Generate a secure key in production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
CMS_SECRET=change-me-to-a-secure-random-secret-in-production

# Enable or disable CSRF protection (true/false). Default: true.
CMS_CSRF_ENABLED=true

# ------------------------------------------------------------------------------
# Database and Storage Paths
# ------------------------------------------------------------------------------
# Database file path (SQLite).
# Local development default: instance/cms.sqlite
# Vercel serverless default: /tmp/confman_instance/cms.sqlite
CMS_DATABASE=instance/cms.sqlite

# Directory path for uploaded paper PDF files.
# Local development default: instance/uploads
# Vercel serverless default: /tmp/confman_instance/uploads
CMS_UPLOAD_FOLDER=instance/uploads

# ------------------------------------------------------------------------------
# Demo and Seeding Configuration
# ------------------------------------------------------------------------------
# Automatically populate demo data (conferences, papers, reviews, users) if empty.
# Local development default: false (run.py enables it for standalone interactive demo)
# Vercel serverless default: true (provides an interactive ready-to-use demo)
CMS_AUTO_SEED=true

# ------------------------------------------------------------------------------
# Local Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
FLASK_DEBUG=false
